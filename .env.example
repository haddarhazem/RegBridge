APP_NAME=RegBridge
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://regbridge:regbridge@localhost:5432/regbridge
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=https://api.regbridge.example/
