APP_NAME=RegBridge
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://regbridge:regbridge@127.0.0.1:55432/regbridge
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=https://api.regbridge.example/
# Public browser client configuration for Authorization Code + PKCE.
OIDC_CLIENT_ID=regbridge-browser
OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback/
OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:8000/auth/login/
OIDC_SCOPE=openid profile email
# Optional provider-specific authorization parameters. Set only when required.
# OIDC_AUTHORIZATION_AUDIENCE=https://api.regbridge.example/
# OIDC_RESOURCE=https://api.regbridge.example/
# Optional: override the standard issuer discovery URL.
# OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
OIDC_ALGORITHMS=RS256

# Local Keycloak development/test provider (`docker compose up -d keycloak`).
# Replace the generic OIDC values above with these when running the local flow:
# OIDC_ISSUER=http://127.0.0.1:18080/realms/regbridge
# OIDC_AUDIENCE=regbridge-api
# OIDC_CLIENT_ID=regbridge-frontend
# OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback/
# OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:8000/auth/login/
# OIDC_SCOPE=openid profile email
# No OIDC client secret is used.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=regbridge-dev-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=<development-only-admin-password>
DOCUMENT_MAX_UPLOAD_BYTES=26214400
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=regbridge-documents
OBJECT_STORAGE_ACCESS_KEY=local-access-key
OBJECT_STORAGE_SECRET_KEY=local-secret-key
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SECURE=false
# Optional production/server-side encryption setting.
# OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

MISTRAL_API_KEY=<your-mistral-api-key>
MISTRAL_MODEL=<supported-mistral-chat-model>

QDRANT_URL=<your-qdrant-url>
QDRANT_API_KEY=<your-qdrant-key>
QDRANT_COLLECTION=reglementation_chunks

BGE_M3_MODEL_NAME=BAAI/bge-m3
BGE_M3_DEVICE=cpu
