APP_NAME=RegBridge
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://regbridge:regbridge@127.0.0.1:55432/regbridge
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=https://api.regbridge.example/
# Optional: override the standard issuer discovery URL.
# OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
OIDC_ALGORITHMS=RS256
DOCUMENT_MAX_UPLOAD_BYTES=26214400
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=regbridge-documents
OBJECT_STORAGE_ACCESS_KEY=local-access-key
OBJECT_STORAGE_SECRET_KEY=local-secret-key
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SECURE=false
# Optional production/server-side encryption setting.
# OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
